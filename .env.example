# GatiAI Environment Variables
# --------------------------------

# GEMINI_API_KEY: Required for the AI tradeoff explanation.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# ORS_API_KEY: Required for OpenRouteService routing (2 alternative routes).
# Get a free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY="your_openrouteservice_api_key_here"

# APP_URL: The URL where this app is hosted (used in production).
APP_URL="http://localhost:3000"
